<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="230dp"
    android:layout_height="350dp"
    android:orientation="vertical"
    android:background="@drawable/glass_popup"
    android:padding="12dp">

    <!-- Baris 1: Esc, Tab, Win -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/kEsc" style="@style/KeyGlass" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:text="esc" android:textSize="14sp" />
        <TextView android:id="@+id/kTab" style="@style/KeyGlass" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="8dp" android:text="⇥" />
        <TextView android:id="@+id/kWin" style="@style/KeyGlass" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="8dp" android:text="❖" />
    </LinearLayout>

    <!-- Baris 2: Del, (kosong), ⚙ (Settings) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/kDel" style="@style/KeyGlass" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent" android:text="⌦" />
        <View android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" />
        <TextView android:id="@+id/kSettings" style="@style/KeyGlass" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="8dp" android:text="⚙"
            android:contentDescription="Ctrl+, buka pengaturan" />
    </LinearLayout>

    <!-- Baris 3: ScreenOff, Lock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView android:id="@+id/kScreenOff" style="@style/KeyGlass" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent" android:text="◑"
            android:contentDescription="matikan layar pc" />
        <TextView android:id="@+id/kLock" style="@style/KeyGlass" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="8dp" android:text="⚿" android:contentDescription="kunci pc" />
    </LinearLayout>

    <!-- Separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/glass_dim" />

    <!-- Container for macros: visibility="gone" by default -->
    <LinearLayout
        android:id="@+id/macroContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
</LinearLayout>
