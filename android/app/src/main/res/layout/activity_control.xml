<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootControl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_scrim"
    android:fitsSystemWindows="true"
    android:padding="10dp">

    <!-- ============ Bar atas ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:text="..." />

        <TextView
            android:id="@+id/tvPing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:visibility="gone"
            android:text="" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnRotate"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/glass_round"
            android:gravity="center"
            android:text="⤢"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:contentDescription="Ubah orientasi" />

        <TextView
            android:id="@+id/btnPresentation"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/glass_round"
            android:gravity="center"
            android:text="⬡"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:contentDescription="Mode presentasi" />

        <TextView
            android:id="@+id/btnDisconnect"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/glass_round"
            android:gravity="center"
            android:text="⏻"
            android:textColor="@color/red"
            android:textSize="16sp"
            android:contentDescription="Putuskan koneksi" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/glass_round"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:contentDescription="Setting" />
    </LinearLayout>

    <!-- ============ Now Playing (v3.7, tersembunyi bila tanpa pemutar) ============ -->
    <LinearLayout
        android:id="@+id/nowPlayingCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/npStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textSize="14sp"
                android:textColor="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/npTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/npArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <SeekBar
            android:id="@+id/npSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ============ Trackpad ============ -->
    <com.bjorn.claudepad.TrackpadView
        android:id="@+id/trackpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="150dp" />

    <LinearLayout
        android:id="@+id/normalControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ Tombol mouse ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnLeft"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:text="◐" />

            <TextView
                android:id="@+id/btnMiddle"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="⊙" />

            <TextView
                android:id="@+id/btnRight"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_marginStart="6dp"
                android:text="◑" />
        </LinearLayout>

        <!-- ============ Keyboard (di bawah kontrol mouse) ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/etType"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="46dp"
                android:background="@drawable/glass_input"
                android:gravity="center_vertical"
                android:text="ketik di sini"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:paddingHorizontal="14dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/kEnter"
                style="@style/KeyGlassAccent"
                android:layout_width="56dp"
                android:layout_marginStart="6dp"
                android:text="⏎" />
        </LinearLayout>

        <!-- ============ Baris pintasan + dropdown Advance ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView android:id="@+id/btnClipGroup" style="@style/KeyGlass"
                android:layout_width="0dp" android:layout_weight="1" android:text="⧉"
                android:contentDescription="salin dan tempel" />
            <TextView android:id="@+id/btnUndoGroup" style="@style/KeyGlass"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="↩"
                android:contentDescription="urungkan dan ulangi" />
            <TextView android:id="@+id/kWinTab" style="@style/KeyGlass"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="⇌" />
            <TextView android:id="@+id/kCloseTab" style="@style/KeyGlass"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="⊗"
                android:contentDescription="Ctrl+W tutup tab" />
            <TextView android:id="@+id/btnAdvance" style="@style/KeyGlass"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_marginStart="6dp" android:text="⋯" />
        </LinearLayout>

        <!-- ============ Baris bawah: 2 kolom seimbang (tinggi TETAP agar
             trackpad di atasnya selalu kebagian ruang) ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:baselineAligned="false">

            <!-- Kolom kiri: volume + media -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="@drawable/glass_panel"
                android:padding="10dp">

                <com.bjorn.claudepad.VolumeSlider
                    android:id="@+id/volumeSlider"
                    android:layout_width="44dp"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView android:id="@+id/mPlay" style="@style/KeyGlassAccent"
                        android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:text="⏯" android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">
                        <TextView android:id="@+id/mPrev" style="@style/KeyGlass" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_height="match_parent" android:text="⏮" />
                        <TextView android:id="@+id/mNext" style="@style/KeyGlass" android:layout_width="0dp"
                            android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_marginStart="6dp" android:text="⏭" />
                    </LinearLayout>

                    <TextView android:id="@+id/btnConnGroup" style="@style/KeyGlass"
                        android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:layout_marginTop="6dp"
                        android:text="SIGNAL" android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:contentDescription="kontrol koneksi pc" />
                </LinearLayout>
            </LinearLayout>

            <!-- Kolom kanan: D-Pad (ukuran panel SAMA dengan kolom kiri) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/glass_panel"
                android:padding="10dp">

                <com.bjorn.claudepad.DpadView
                    android:id="@+id/dpad"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/presentationControls"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:background="@drawable/glass_panel"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/presLeft"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="←"
                android:textSize="24sp"
                android:contentDescription="slide sebelumnya" />

            <TextView
                android:id="@+id/presRight"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:text="→"
                android:textSize="24sp"
                android:contentDescription="slide berikutnya" />

            <TextView
                android:id="@+id/presWinP"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:text="⬡"
                android:textSize="24sp"
                android:contentDescription="Win+P proyektor" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/presEsc"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="Esc"
                android:textSize="14sp"
                android:contentDescription="escape" />

            <TextView
                android:id="@+id/presF11"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:text="F11"
                android:textSize="14sp"
                android:contentDescription="fullscreen slide" />

            <TextView
                android:id="@+id/presExit"
                style="@style/KeyGlass"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:text="✕"
                android:textSize="24sp"
                android:textColor="@color/red"
                android:contentDescription="kembali ke normal" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
